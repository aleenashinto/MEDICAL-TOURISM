# ─── MAIDES — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to version control

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://maides:maides_dev_password@localhost:5432/maides

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_random_32_char_string_in_production
JWT_EXPIRY=7d
COOKIE_SECRET=change_this_cookie_secret_to_random_32_chars_too

# ── API Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000

# ── MinIO / S3 Document Storage ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=maides-documents
S3_ACCESS_KEY=maides_minio
S3_SECRET_KEY=maides_minio_secret
S3_REGION=ap-south-1
S3_FORCE_PATH_STYLE=true
